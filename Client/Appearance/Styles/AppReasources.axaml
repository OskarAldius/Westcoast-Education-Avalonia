<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->


  <LinearGradientBrush x:Key="PrimaryBackgroundGradient" StartPoint="0% 0%" EndPoint="100% 0%">
            <GradientStop Offset="0" Color="#0B333F"/>
            <GradientStop Offset="1" Color="#45828D"/>
        </LinearGradientBrush>
<SolidColorBrush x:Key="BackgroundColor">#0b333f</SolidColorBrush>
<SolidColorBrush x:Key="ForegroundColor">#A7BDCF</SolidColorBrush>
<SolidColorBrush x:Key="ChangeBrush">#1D8A3C</SolidColorBrush>
<SolidColorBrush x:Key="DeleteBrush">#BC2214</SolidColorBrush>
<SolidColorBrush x:Key="InputBackground">#26858E</SolidColorBrush>
<SolidColorBrush x:Key="InputBorder">#21626F</SolidColorBrush>
<SolidColorBrush x:Key="AccentBorder">#C5E9F3</SolidColorBrush>
<SolidColorBrush x:Key="DividerBrush">#FFFFFF</SolidColorBrush>
</ResourceDictionary>
