<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.StudentView"
             x:DataType="vm:StudentViewModel">

             <Design.DataContext>
              <vm:StudentViewModel></vm:StudentViewModel>
             </Design.DataContext>

             <StackPanel>
                <TextBlock Classes="pageTitlte" Text="Våra Studenter"/>

                <Border BorderBrush="White" BorderThickness=" 0 0 0 1" Padding="0 50 0 5">
                    <Grid ColumnDefinitions="100,100,200,100,100,100" ShowGridLines="True">
                        <Label Content="Namn" />
                        <Label Grid.Column="1" Content="Efternamn"/>
                        <Label Grid.Column="2" Content="Telefonnummer"/>
                        <Label Grid.Column="3" Content="Adress"/>
                        <Label Grid.Column="4" Content="Postkod"/>
                        <Label Grid.Column="5" Content="Stad"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Students}" Margin="0 10 0 0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="100,100,200,100,100,100" ShowGridLines="True">
                                <Label Content="{Binding FirstName}"/>
                                <Label Grid.Column="1" Content="{Binding LastName}"/>
                                <Label Grid.Column="2" Content="{Binding PhoneNumber}"/>
                                <Label Grid.Column="3" Content="{Binding Address}"/>
                                <Label Grid.Column="4" Content="{Binding Postcode}"/>
                                <Label Grid.Column="5" Content="{Binding City}"/>

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
             </StackPanel>
</UserControl>
