<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.TeacherView"
             x:DataType="vm:TeacherViewModel">

             <Design.DataContext>
              <vm:TeacherViewModel></vm:TeacherViewModel>
             </Design.DataContext>
             <StackPanel>
                <TextBlock Classes="pageTitle" Text="{Binding PageTitle}"/>

                <Border  BorderBrush="White" BorderThickness=" 0 0 0 1" Padding="0 50 0 5">
                    <Grid ColumnDefinitions="100,150,200,180,60,60" ShowGridLines="True">
                        <Label Content="Namn" />
                        <Label Grid.Column="1" Content="Efternamn"/>
                        <Label Grid.Column="2" Content="Telefonnummer"/>
                        <Label Grid.Column="3" Content="Kunskapsområde"/>
                        <Label Grid.Column="4" HorizontalAlignment="Right" Content="Ändra"/>
                        <Label Grid.Column="5" HorizontalAlignment="Right" Content="Ta bort"/>
                    </Grid>
                </Border>
                 <ScrollViewer Height="300">
                    <ItemsControl ItemsSource="{Binding Teachers}" Margin="0 10 0 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,150,200,180,60,60" ShowGridLines="True">
                                    <Label Content="{Binding FirstName}"/>
                                    <Label Grid.Column="1" Content="{Binding LastName}"/>
                                    <Label Grid.Column="2" Content="{Binding PhoneNumber}"/>
                                    <Label Grid.Column="3" Content="{Binding FieldOfKnowledge}"/>
                                    <Label Grid.Column="4" HorizontalAlignment="Right"/>
                                    <Label Grid.Column="5" HorizontalAlignment="Right"/>
                                    
                                </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
             </StackPanel>
</UserControl>
