<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.AddStudentView"
             x:DataType="vm:AddStudentViewModel">

             <Design.DataContext>
                <vm:AddStudentViewModel></vm:AddStudentViewModel>
             </Design.DataContext>

             <StackPanel>
                <TextBlock Classes="pageTitle" Text="{Binding PageTitle}" />
                <Border HorizontalAlignment="Center" Padding="0 30" BorderBrush="#C5E9F3" BorderThickness="0">
                    <StackPanel>
                        <Grid RowSpacing="10" ColumnSpacing="10" ColumnDefinitions="300,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ShowGridLines="false">
                            <Label HorizontalAlignment="Right" Content="Namn:" />
                            <Label HorizontalAlignment="Right" Grid.Row="1" Content="Efternamn:"/>
                            <Label HorizontalAlignment="Right" Grid.Row="2" Content="Telefonummer:"/>
                            <Label HorizontalAlignment="Right" Grid.Row="3" Content="Adress:"/>
                            <Label HorizontalAlignment="Right" Grid.Row="4" Content="Postkod:"/>
                            <Label HorizontalAlignment="Right" Grid.Row="5" Content="Stad:"/>
                            <TextBox Text="{Binding FirstName}" Grid.Column="1" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding LastName}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding PhoneNumber}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding Address}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding Postcode}" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding City}" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Left" />
                        </Grid>
                        <StackPanel Spacing="20" Margin="0 30 0 0" Orientation="Horizontal" HorizontalAlignment="Center"> 
                    <Button Classes="button" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                          <Label Content="Spara" />
                        </StackPanel>
                    </Button>
                     <Button Classes="button" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToStudentsCommand}">
                        <StackPanel Orientation="Horizontal">
                          <Label Content="Avbryt" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    </StackPanel>
                </Border>
             </StackPanel>
             
</UserControl>
