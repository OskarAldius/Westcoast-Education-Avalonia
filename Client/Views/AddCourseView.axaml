<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.AddCourseView"
             x:DataType="vm:AddCourseViewModel">
  <Design.DataContext>
    <vm:AddCourseViewModel></vm:AddCourseViewModel>
  </Design.DataContext>
   <StackPanel>
                <TextBlock Classes="pageTitle" Text="{Binding PageTitle}" />
                <Border HorizontalAlignment="Center" Padding="0 30" BorderBrush="#C5E9F3" BorderThickness="0">
                    <StackPanel>
                        <Grid RowSpacing="10" ColumnSpacing="10" ColumnDefinitions="300,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ShowGridLines="false">
                            <Label HorizontalAlignment="Right" Content="Titel:" />
                            <Label HorizontalAlignment="Right" Grid.Row="1" Content="StartDatum:"/>
                            <Label HorizontalAlignment="Right" Grid.Row="2" Content="SlutDatum:"/>
                            <Label HorizontalAlignment="Right" Grid.Row="3" Content="Kurslängd:"/>
                  
                            <TextBox Text="{Binding Title}" Grid.Column="1" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding StartDate}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding EndDate}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" />
                            <TextBox Text="{Binding CoursLength}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" />
                           
                        </Grid>
                        <StackPanel Spacing="20" Margin="0 30 0 0" Orientation="Horizontal" HorizontalAlignment="Center"> 
                    <Button Classes="button" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                          <Label Content="Spara" />
                        </StackPanel>
                    </Button>
                     <Button Classes="button" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCoursesCommand}">
                        <StackPanel Orientation="Horizontal">
                          <Label Content="Avbryt" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    </StackPanel>
                </Border>
             </StackPanel>
             
</UserControl>

